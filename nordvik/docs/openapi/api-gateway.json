{
  "openapi": "3.0.1",
  "info": {
    "title": "api-gateway",
    "description": "Entrada única: enruta /{servicio}/... al microservicio, aplica cuotas, valida tokens activos y añade X-Correlation-Id.\n\nDominio: B-platform · Equipo: Plataforma · Oleada: 1 · Puerto: 6100\n\nDepende de: rate-limiter, iam-service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/routes": {
      "get": {
        "tags": [
          "Gateway"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Route"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Route": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "nullable": true
          },
          "gatewayPrefix": {
            "type": "string",
            "nullable": true
          },
          "target": {
            "type": "string",
            "nullable": true
          },
          "authRequired": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}