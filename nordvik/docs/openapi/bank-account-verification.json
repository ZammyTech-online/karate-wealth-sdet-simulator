{
  "openapi": "3.0.1",
  "info": {
    "title": "bank-account-verification",
    "description": "Cuentas bancarias de destino del cliente: IBAN válido, titularidad confirmada por el banco, revisión manual si hay dudas y step-up para añadirlas.\n\nDominio: K-payments · Equipo: Pagos y contabilidad · Oleada: 2 · Puerto: 7002\n\nDepende de: nordpay-adapter, customer-registry, permission-service, clock-service",
    "version": "1.0.0"
  },
  "paths": {
