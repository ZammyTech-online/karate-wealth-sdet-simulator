      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
