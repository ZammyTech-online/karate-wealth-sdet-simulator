        "type": "object",
        "properties": {
          "requests": {
            "type": "integer",
            "format": "int64"
          },
          "feedCalls": {
            "type": "integer",
            "format": "int64"
          },
          "notModified": {
            "type": "integer",
            "format": "int64"
          },
          "cacheHits": {
            "type": "integer",
            "format": "int64"
          },
          "staleServed": {
            "type": "integer",
            "format": "int64"
          },
          "errors": {
