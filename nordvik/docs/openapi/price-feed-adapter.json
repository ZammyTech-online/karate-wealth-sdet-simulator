{
  "openapi": "3.0.1",
  "info": {
    "title": "price-feed-adapter",
    "description": "Adaptador del proveedor de precios E5 con caché por ETag, contadores de 304 y respuesta stale si el proveedor cae.\n\nDominio: P-integrations · Equipo: Integraciones · Oleada: 2 · Puerto: 7501\n\nDepende de: pricefeed-sim, clock-service",
    "version": "1.0.0"
  },
  "paths": {
