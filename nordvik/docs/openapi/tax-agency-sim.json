{
  "openapi": "3.0.1",
  "info": {
    "title": "tax-agency-sim",
    "description": "E8 Agencia Tributaria: tablas de retención por número nacional (con API key) y ficheros anuales de control con acuse línea a línea.\n\nDominio: X-external · Equipo: Sistema externo (simulado) · Oleada: 4 · Puerto: 7708\n\nDepende de: clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/__admin/behaviour": {
      "get": {
        "tags": [
          "Administración del simulador"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BehaviourRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/__admin/behaviour/reset": {
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/__admin/filings": {
      "get": {
        "tags": [
          "Administración del simulador"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/__admin/reject-next": {
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectNextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/__admin/reset": {
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/v1/tax-tables/{personalNumber}": {
      "get": {
        "tags": [
          "Agencia Tributaria v1"
        ],
        "parameters": [
          {
            "name": "personalNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/v1/filings": {
      "post": {
        "tags": [
          "Agencia Tributaria v1"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FilingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BehaviourRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "nullable": true
          },
          "delayMs": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "failNext": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FilingLine": {
        "type": "object",
        "properties": {
          "personalNumber": {
            "type": "string",
            "nullable": true
          },
          "incomeType": {
            "type": "string",
            "nullable": true
          },
          "gross": {
            "type": "string",
            "nullable": true
          },
          "taxWithheld": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FilingRequest": {
        "type": "object",
        "properties": {
          "reporter": {
            "type": "string",
            "nullable": true
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "nullable": true
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilingLine"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RejectNextRequest": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}