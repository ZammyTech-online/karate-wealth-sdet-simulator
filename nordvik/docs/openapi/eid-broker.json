{
  "openapi": "3.0.1",
  "info": {
    "title": "eid-broker",
    "description": "Autenticación y firma con NordID (E1): orderRef, sondeo, caducidad a 3 min y borrado del resultado a los 10 min (dato efímero).\n\nDominio: C-identity · Equipo: Identidad · Oleada: 2 · Puerto: 6203\n\nDepende de: nordid-sim, clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/eid/auth": {
      "post": {
        "tags": [
          "NordID"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EidAuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/eid/sign": {
      "post": {
        "tags": [
          "NordID"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EidSignRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/eid/orders/{orderRef}": {
      "get": {
        "tags": [
          "NordID"
        ],
        "parameters": [
          {
            "name": "orderRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EidOrder"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/eid/orders/{orderRef}/cancel": {
      "post": {
        "tags": [
          "NordID"
        ],
        "parameters": [
          {
            "name": "orderRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EidAuthRequest": {
        "type": "object",
        "properties": {
          "personalNumber": {
            "type": "string",
            "nullable": true
          },
          "purpose": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EidOrder": {
        "type": "object",
        "properties": {
          "orderRef": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "hintCode": {
            "type": "string",
            "nullable": true
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "purpose": {
            "type": "string",
            "nullable": true
          },
          "maskedPersonalNumber": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/EidUser"
          },
          "signature": {
            "type": "string",
            "nullable": true
          },
          "signedDataHash": {
            "type": "string",
            "nullable": true
          },
          "purgeAt": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EidSignRequest": {
        "type": "object",
        "properties": {
          "personalNumber": {
            "type": "string",
            "nullable": true
          },
          "visibleText": {
            "type": "string",
            "nullable": true
          },
          "dataHash": {
            "type": "string",
            "nullable": true
          },
          "purpose": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EidUser": {
        "type": "object",
        "properties": {
          "personalNumber": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}