{
  "openapi": "3.0.1",
  "info": {
    "title": "employer-portal-api",
    "description": "API de empresas con API key (X-Employer-Key): alta de empleados con su plan OCCUPATIONAL por convenio, consulta enmascarada y aportaciones del mes.\n\nDominio: L-pensions · Equipo: Pensiones · Oleada: 3 · Puerto: 7102\n\nDepende de: pension-plan-service, customer-registry, contribution-service, clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/employers": {
      "post": {
        "tags": [
          "Empresas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/employer/employees": {
      "post": {
        "tags": [
          "Portal de empresas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmployeeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "get": {
        "tags": [
          "Portal de empresas"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/employer/contributions": {
      "get": {
        "tags": [
          "Portal de empresas"
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmployeeRequest": {
        "type": "object",
        "properties": {
          "personalNumber": {
            "type": "string",
            "nullable": true
          },
          "allocation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanAllocationRequestLine"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EmployerRequest": {
        "type": "object",
        "properties": {
          "orgNumber": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "agreement": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PlanAllocationRequestLine": {
        "type": "object",
        "properties": {
          "isin": {
            "type": "string",
            "nullable": true
          },
          "percent": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  }
}