{
  "openapi": "3.0.1",
  "info": {
    "title": "isin-service",
    "description": "Genera ISIN válidos y valida el dígito de control de cualquier ISIN.\n\nDominio: A-utilities · Equipo: Plataforma de datos de prueba · Oleada: 1 · Puerto: 6008",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/isins": {
      "post": {
        "tags": [
          "ISIN"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIsinRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IsinCode"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/isins/validate": {
      "post": {
        "tags": [
          "ISIN"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateIsinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IsinValidation"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateIsinRequest": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "nullable": true
          },
          "seed": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "IsinCode": {
        "type": "object",
        "properties": {
          "isin": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "nsin": {
            "type": "string",
            "nullable": true
          },
          "checkDigit": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "IsinValidation": {
        "type": "object",
        "properties": {
          "isin": {
            "type": "string",
            "nullable": true
          },
          "formatOk": {
            "type": "boolean"
          },
          "valid": {
            "type": "boolean"
          },
          "expectedCheckDigit": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValidateIsinRequest": {
        "type": "object",
        "properties": {
          "isin": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}