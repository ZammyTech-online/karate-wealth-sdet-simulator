  "components": {
    "schemas": {
      "QuoteRequest": {
        "type": "object",
        "properties": {
          "capital": {
            "type": "string",
            "nullable": true
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "termYears": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "technicalRatePct": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "guaranteeYears": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
