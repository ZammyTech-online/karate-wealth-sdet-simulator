{
  "openapi": "3.0.1",
  "info": {
    "title": "annuity-calculator",
    "description": "Rentas temporales y vitalicias con tabla de mortalidad sintética (Gompertz-Makeham) e interés técnico; esperanza de vida y factores, deterministas.\n\nDominio: L-pensions · Equipo: Pensiones · Oleada: 3 · Puerto: 7112",
    "version": "1.0.0"
  },
  "paths": {
