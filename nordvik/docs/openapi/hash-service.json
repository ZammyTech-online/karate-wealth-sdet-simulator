{
  "openapi": "3.0.1",
  "info": {
    "title": "hash-service",
    "description": "Calcula el JSON canónico y su SHA-256 (como contentHash), SHA-256 de texto y HMAC-SHA256 de webhooks.\n\nDominio: A-utilities · Equipo: Plataforma de datos de prueba · Oleada: 2 · Puerto: 6011",
    "version": "1.0.0"
  },
  "paths": {
