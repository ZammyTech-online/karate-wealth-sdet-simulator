          "sha256": {
            "type": "string",
            "nullable": true
          },
          "bytes": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "HmacRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "encoding": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "HmacResult": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string",
            "nullable": true
          },
          "signature": {
            "type": "string",
            "nullable": true
          },
          "encoding": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "HmacVerifyRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "signature": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TextHashRequest": {
