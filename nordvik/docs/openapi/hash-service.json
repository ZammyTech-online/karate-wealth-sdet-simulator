            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "VerifyResult": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "expected": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
