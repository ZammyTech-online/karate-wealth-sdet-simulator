{
  "openapi": "3.0.1",
  "info": {
    "title": "kyc-aml-service",
    "description": "Casos KYC: cribado + PEP + riesgo en orden, aprobación automática según riesgo, revisión de Cumplimiento con cuatro ojos y fecha de próxima revisión.\n\nDominio: E-compliance · Equipo: Cumplimiento normativo · Oleada: 3 · Puerto: 6400\n\nDepende de: sanctions-adapter, pep-service, risk-scoring, customer-registry, clock-service",
    "version": "1.0.0"
  },
