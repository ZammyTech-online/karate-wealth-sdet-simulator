{
  "openapi": "3.0.1",
  "info": {
    "title": "fund-factsheet",
    "description": "Ficha comercial del fondo por idioma: objetivo, explicación del riesgo, comisiones y rentabilidad a 1, 3 y 12 meses.\n\nDominio: I-market · Equipo: Inversiones · Oleada: 1 · Puerto: 6805\n\nDepende de: product-catalog, market-data, clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/factsheets/{isin}": {
      "get": {
        "tags": [
          "Fichas"
        ],
        "parameters": [
          {
            "name": "isin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Factsheet"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Factsheet": {
        "type": "object",
        "properties": {
          "isin": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "sri": {
            "type": "integer",
            "format": "int32"
          },
          "objective": {
            "type": "string",
            "nullable": true
          },
          "risk_text": {
            "type": "string",
            "nullable": true
          },
          "fees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FactsheetFee"
            },
            "nullable": true
          },
          "performance": {
            "$ref": "#/components/schemas/Performance"
          },
          "warning": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FactsheetFee": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "percent": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Performance": {
        "type": "object",
        "properties": {
          "one_month": {
            "type": "string",
            "nullable": true
          },
          "three_months": {
            "type": "string",
            "nullable": true
          },
          "one_year": {
            "type": "string",
            "nullable": true
          },
          "as_of": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}