{
  "openapi": "3.0.1",
  "info": {
    "title": "data-reset-service",
    "description": "Da un prefijo único por ejecución y borra todo lo creado con él en todos los servicios encendidos.\n\nDominio: A-utilities · Equipo: Plataforma de datos de prueba · Oleada: 1 · Puerto: 6009\n\nDepende de: clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/runs": {
      "post": {
        "tags": [
          "Ejecuciones"
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPrefix"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{prefix}": {
      "delete": {
        "tags": [
          "Ejecuciones"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetReport"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResetReport": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "nullable": true
          },
          "totalDeleted": {
            "type": "integer",
            "format": "int32"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceReset"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RunPrefix": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ServiceReset": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "deleted": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}