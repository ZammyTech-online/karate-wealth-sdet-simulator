            "nullable": true
          },
          "customerId": {
            "type": "string",
            "nullable": true
          },
          "advisorId": {
            "type": "string",
            "nullable": true
          },
          "scope": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
