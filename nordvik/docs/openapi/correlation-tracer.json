{
  "openapi": "3.0.1",
  "info": {
    "title": "correlation-tracer",
    "description": "Reconstruye la cadena de llamadas de un correlationId a partir de los logs (servicio, ruta, estado, duración y anidamiento).\n\nDominio: B-platform · Equipo: Plataforma · Oleada: 2 · Puerto: 6108",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/traces/{correlationId}": {
      "get": {
        "tags": [
          "Trazas"
        ],
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trace"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Hop": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer",
            "format": "int32"
          },
          "depth": {
            "type": "integer",
            "format": "int32"
          },
          "service": {
            "type": "string",
            "nullable": true
          },
          "method": {
            "type": "string",
            "nullable": true
          },
          "path": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "ms": {
            "type": "integer",
            "format": "int64"
          },
          "startedAt": {
            "type": "string",
            "nullable": true
          },
          "endedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Trace": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "nullable": true
          },
          "hops": {
            "type": "integer",
            "format": "int32"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "totalMs": {
            "type": "integer",
            "format": "int64"
          },
          "errors": {
            "type": "integer",
            "format": "int32"
          },
          "firstError": {
            "type": "string",
            "nullable": true
          },
          "chain": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hop"
            },
            "nullable": true
          },
          "tree": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}