{
  "openapi": "3.0.1",
  "info": {
    "title": "outbox-relay",
    "description": "Publica en event-bus los eventos guardados en el outbox de cada servicio. Pausable para practicar consistencia eventual.\n\nDominio: O-operations · Equipo: Plataforma de eventos · Oleada: 2 · Puerto: 7401\n\nDepende de: event-bus",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/relay/status": {
      "get": {
        "tags": [
          "Relay"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelayStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/relay/pause": {
      "post": {
        "tags": [
          "Relay"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/relay/resume": {
      "post": {
        "tags": [
          "Relay"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/relay/flush": {
      "post": {
        "tags": [
          "Relay"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RelayStatus": {
        "type": "object",
        "properties": {
          "paused": {
            "type": "boolean"
          },
          "intervalMs": {
            "type": "integer",
            "format": "int32"
          },
          "totalRelayed": {
            "type": "integer",
            "format": "int64"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SourceStatus": {
        "type": "object",
        "properties": {
          "producer": {
            "type": "string",
            "nullable": true
          },
          "cursor": {
            "type": "integer",
            "format": "int64"
          },
          "relayed": {
            "type": "integer",
            "format": "int64"
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "lastError": {
            "type": "string",
            "nullable": true
          },
          "lastRelayAt": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}