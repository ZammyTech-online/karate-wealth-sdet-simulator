{
  "openapi": "3.0.1",
  "info": {
    "title": "meeting-scheduler",
    "description": "Agenda del asesor: huecos de 60 min en su horario y días hábiles, reservas sin solapes, cancelación tardía (<24 h) y recordatorios 24 h antes por notification-service.\n\nDominio: G-advice · Equipo: Asesoramiento y comunicación · Oleada: 3 · Puerto: 6604\n\nDepende de: advisor-directory, permission-service, customer-registry, notification-service, clock-service",
    "version": "1.0.0"
  },
  "paths": {
