{
  "openapi": "3.0.1",
  "info": {
    "title": "text-factory",
    "description": "Mensajes de cliente con PII opcional (personnummer, IBAN, teléfono) y guiones de llamada V1-V5 con marcas de tiempo.\n\nDominio: A-utilities · Equipo: Plataforma de datos de prueba · Oleada: 2 · Puerto: 6012",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/texts/customer-message": {
      "post": {
        "tags": [
          "Textos"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/texts/call-script": {
      "post": {
        "tags": [
          "Textos"
        ],
        "parameters": [
          {
            "name": "scenario",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallScript"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/texts/lorem": {
      "get": {
        "tags": [
          "Textos"
        ],
        "parameters": [
          {
            "name": "words",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CallScript": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "nullable": true
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "durationMs": {
            "type": "integer",
            "format": "int32"
          },
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScriptTurn"
            },
            "nullable": true
          },
          "piiPresent": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MessageRequest": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "nullable": true
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "includePii": {
            "type": "boolean",
            "nullable": true
          },
          "seed": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ScriptTurn": {
        "type": "object",
        "properties": {
          "turn": {
            "type": "integer",
            "format": "int32"
          },
          "speaker": {
            "type": "string",
            "nullable": true
          },
          "text": {
            "type": "string",
            "nullable": true
          },
          "offsetMs": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}