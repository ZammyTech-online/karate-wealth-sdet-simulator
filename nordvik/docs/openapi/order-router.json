{
  "openapi": "3.0.1",
  "info": {
    "title": "order-router",
    "description": "Ventana de lotes: a la hora de corte agrupa las órdenes por fecha de negociación y las envía al custodio. Reintenta si el custodio no está.\n\nDominio: J-investment · Equipo: Inversiones · Oleada: 2 · Puerto: 6903\n\nDepende de: order-management, custody-adapter, config-service, clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/batches/run": {
      "post": {
        "tags": [
          "Lotes"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/batches": {
      "get": {
        "tags": [
          "Lotes"
        ],
        "parameters": [
          {
            "name": "tradeDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RouterBatch"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/batches/{batchId}": {
      "get": {
        "tags": [
          "Lotes"
        ],
        "parameters": [
          {
            "name": "batchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouterBatch"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RouterBatch": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string",
            "nullable": true
          },
          "tradeDate": {
            "type": "string",
            "nullable": true
          },
          "orderIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          },
          "trigger": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RunResult": {
        "type": "object",
        "properties": {
          "batches": {
            "type": "integer",
            "format": "int32"
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "sent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouterBatch"
            },
            "nullable": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}