{
  "openapi": "3.0.1",
  "info": {
    "title": "pricefeed-sim",
    "description": "E5 Proveedor de precios: NAV por fondo y fecha, descarga masiva por día, ETag/304 y API key.\n\nDominio: X-external · Equipo: Sistema externo (simulado) · Oleada: 2 · Puerto: 7705\n\nDepende de: clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/__admin/behaviour": {
      "get": {
        "tags": [
          "Administración del simulador"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BehaviourRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/__admin/behaviour/reset": {
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/feed/v1/nav/{isin}": {
      "get": {
        "tags": [
          "Feed de precios v1"
        ],
        "parameters": [
          {
            "name": "isin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/feed/v1/nav": {
      "get": {
        "tags": [
          "Feed de precios v1"
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BehaviourRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "nullable": true
          },
          "delayMs": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "failNext": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}