{
  "openapi": "3.0.1",
  "info": {
    "title": "population-sim",
    "description": "E2 Registro de Población: persona por número nacional con mTLS simulado, identidad protegida, fallecidos y 404; precarga en /__admin/persons.\n\nDominio: X-external · Equipo: Sistema externo (simulado) · Oleada: 3 · Puerto: 7702\n\nDepende de: clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/__admin/behaviour": {
      "get": {
        "tags": [
          "Administración del simulador"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BehaviourRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/__admin/behaviour/reset": {
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/__admin/persons": {
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PopulationPerson"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/__admin/unknown/{personalNumber}": {
      "post": {
        "tags": [
          "Administración del simulador"
        ],
        "parameters": [
          {
            "name": "personalNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/__admin/stats": {
      "get": {
        "tags": [
          "Administración del simulador"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/v1/persons/{personalNumber}": {
      "get": {
        "tags": [
          "Registro de Población v1"
        ],
        "parameters": [
          {
            "name": "personalNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BehaviourRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "nullable": true
          },
          "delayMs": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "failNext": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PopulationPerson": {
        "type": "object",
        "properties": {
          "personalNumber": {
            "type": "string",
            "nullable": true
          },
          "givenName": {
            "type": "string",
            "nullable": true
          },
          "surname": {
            "type": "string",
            "nullable": true
          },
          "street": {
            "type": "string",
            "nullable": true
          },
          "postalCode": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "protectedIdentity": {
            "type": "boolean"
          },
          "deceasedDate": {
            "type": "string",
            "nullable": true
          },
          "citizenship": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}