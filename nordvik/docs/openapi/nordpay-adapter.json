            "nullable": true
          },
          "endToEndId": {
            "type": "string",
            "nullable": true
          },
          "bankPaymentId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "reasonCode": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "string",
            "nullable": true
          },
          "creditorIban": {
            "type": "string",
            "nullable": true
          },
          "sentAt": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BankPaymentRequest": {
        "type": "object",
        "properties": {
          "msgId": {
            "type": "string",
            "nullable": true
          },
          "endToEndId": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "string",
            "nullable": true
          },
          "creditorIban": {
            "type": "string",
            "nullable": true
          },
          "creditorName": {
            "type": "string",
            "nullable": true
          },
          "remittance": {
            "type": "string",
            "nullable": true
          },
          "requestedDate": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OwnershipRequest": {
        "type": "object",
        "properties": {
          "iban": {
            "type": "string",
            "nullable": true
          },
          "nationalId": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}