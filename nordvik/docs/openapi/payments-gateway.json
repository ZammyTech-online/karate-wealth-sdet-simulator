{
  "openapi": "3.0.1",
  "info": {
    "title": "payments-gateway",
    "description": "Ingresos con referencia OCR y retiradas con Idempotency-Key, step-up (acr=high) por encima de 10 000 SEK, límite diario y saga asíncrona con el banco.\n\nDominio: K-payments · Equipo: Pagos y contabilidad · Oleada: 2 · Puerto: 7000\n\nDepende de: ledger-service, cash-management, bank-account-verification, payment-instructions, idempotency-store, customer-registry, permission-service, config-service, event-bus, clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/deposits": {
      "post": {
        "tags": [
          "Ingresos"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepositRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          }
        }
      }
    },
