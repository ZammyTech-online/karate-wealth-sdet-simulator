{
  "openapi": "3.0.1",
  "info": {
    "title": "market-data",
    "description": "Precios NAV diarios con 4 decimales, historial y último precio publicado (con ETag).\n\nDominio: I-market · Equipo: Inversiones · Oleada: 0 · Puerto: 6802\n\nDepende de: clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/prices/{isin}": {
      "get": {
        "tags": [
          "Precios NAV"
        ],
        "parameters": [
          {
            "name": "isin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NavPrice"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/prices/{isin}/latest": {
      "get": {
        "tags": [
          "Precios NAV"
        ],
        "parameters": [
          {
            "name": "isin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NavPrice"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/prices/{isin}/history": {
      "get": {
        "tags": [
          "Precios NAV"
        ],
        "parameters": [
          {
            "name": "isin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NavHistory"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NavHistory": {
        "type": "object",
        "properties": {
          "isin": {
            "type": "string",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "from": {
            "type": "string",
            "nullable": true
          },
          "to": {
            "type": "string",
            "nullable": true
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NavPoint"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "NavPoint": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "nullable": true
          },
          "nav": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "NavPrice": {
        "type": "object",
        "properties": {
          "isin": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "nullable": true
          },
          "nav": {
            "type": "string",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "published_at": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}