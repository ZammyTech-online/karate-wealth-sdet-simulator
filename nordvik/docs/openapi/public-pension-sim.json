  "components": {
    "schemas": {
      "BehaviourRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "nullable": true
          },
          "delayMs": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "failNext": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MaintenanceRequest": {
        "type": "object",
        "properties": {
          "on": {
            "type": "boolean",
            "nullable": true
          },
          "retryAfterSeconds": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PpEnvelope": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/PpHeader"
          },
          "body": {
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PpHeader": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "nullable": true
          },
          "signature": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
