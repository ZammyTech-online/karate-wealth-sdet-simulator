{
  "openapi": "3.0.1",
  "info": {
    "title": "tax-agency-adapter",
    "description": "Agencia Tributaria (E8) con API key: tablas de retención cacheadas por persona y año y entrega de ficheros anuales con su acuse.\n\nDominio: P-integrations · Equipo: Integraciones · Oleada: 4 · Puerto: 7507\n\nDepende de: tax-agency-sim, secrets-service, clock-service",
    "version": "1.0.0"
  },
  "paths": {
