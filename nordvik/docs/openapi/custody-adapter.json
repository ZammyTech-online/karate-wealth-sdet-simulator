{
  "openapi": "3.0.1",
  "info": {
    "title": "custody-adapter",
    "description": "Adaptador del custodio E4: envía lotes, recibe webhooks firmados (HMAC), deduplica y publica ejecuciones y rechazos como eventos.\n\nDominio: P-integrations · Equipo: Integraciones · Oleada: 2 · Puerto: 7500\n\nDepende de: custodian-sim, clock-service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/internal/outbox": {
      "get": {
        "tags": [
          "Interno"
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/batches": {
      "post": {
        "tags": [
          "Lotes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SentBatch"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/batches/{batchId}": {
      "get": {
        "tags": [
          "Lotes"
        ],
        "parameters": [
          {
            "name": "batchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SentBatch"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [
          "Plataforma"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/_test/data": {
      "delete": {
        "tags": [
          "Plataforma"
        ],
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/holdings": {
      "get": {
        "tags": [
          "Posiciones"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/webhooks/custody": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/webhooks/stats": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdapterOrder": {
        "type": "object",
        "properties": {
          "clientOrderId": {
            "type": "string",
            "nullable": true
          },
          "accountId": {
            "type": "string",
            "nullable": true
          },
          "isin": {
            "type": "string",
            "nullable": true
          },
          "side": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "string",
            "nullable": true
          },
          "units": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SendBatchRequest": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string",
            "nullable": true
          },
          "tradeDate": {
            "type": "string",
            "nullable": true
          },
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdapterOrder"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SentBatch": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string",
            "nullable": true
          },
          "tradeDate": {
            "type": "string",
            "nullable": true
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "sentAt": {
            "type": "string",
            "nullable": true
          },
          "executedAt": {
            "type": "string",
            "nullable": true
          },
          "executions": {
            "type": "integer",
            "format": "int32"
          },
          "rejections": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}