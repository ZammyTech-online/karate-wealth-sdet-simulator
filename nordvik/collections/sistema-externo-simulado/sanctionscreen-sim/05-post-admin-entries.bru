}

body:json {
  {
    "entryId": "valor",
    "list": "valor",
    "type": "valor",
    "name": "valor",
    "birthDate": "valor",
    "country": "valor",
    "role": "valor",
    "relatedTo": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/sanctionscreen-sim.md
}
