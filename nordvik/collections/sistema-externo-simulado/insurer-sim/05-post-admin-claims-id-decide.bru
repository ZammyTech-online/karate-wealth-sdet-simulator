  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "decision": "valor",
    "amount": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/insurer-sim.md
