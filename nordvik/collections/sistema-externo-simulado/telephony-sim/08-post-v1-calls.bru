meta {
  name: POST /v1/calls
  type: http
  seq: 8
}

post {
  url: {{telephonySimUrl}}/v1/calls
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "from": "valor",
    "to": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/telephony-sim.md
}
