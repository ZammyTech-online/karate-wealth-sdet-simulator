meta {
  name: POST /api/v1/secrets/{name}/verify
  type: http
  seq: 7
}

post {
  url: {{secretsServiceUrl}}/api/v1/secrets/demo/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "name": "valor",
    "value": "valor",
    "description": "valor",
    "graceSeconds": 1
  }
}

docs {
  
  Ficha completa: docs/services/secrets-service.md
}
