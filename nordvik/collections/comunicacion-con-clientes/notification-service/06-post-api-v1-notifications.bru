meta {
  name: POST /api/v1/notifications
  type: http
  seq: 6
}

post {
  url: {{notificationServiceUrl}}/api/v1/notifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "customerId": "valor",
    "to": "valor",
    "channel": "valor",
    "templateKey": "valor",
    "language": "valor",
    "vars": "valor",
    "priority": "valor",
    "category": "valor",
    "reference": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/notification-service.md
}
