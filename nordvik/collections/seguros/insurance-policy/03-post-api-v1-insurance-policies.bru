meta {
  name: POST /api/v1/insurance-policies
  type: http
  seq: 3
}

post {
  url: {{insurancePolicyUrl}}/api/v1/insurance-policies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "customerId": "valor",
    "pensionPlanId": "valor",
    "coverage": "valor",
    "capital": "valor",
    "termYears": 1,
    "healthDeclarationId": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/insurance-policy.md
}
