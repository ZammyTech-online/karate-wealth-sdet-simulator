meta {
  name: POST /api/v1/clock/freeze
  type: http
  seq: 3
}

post {
  url: {{clockServiceUrl}}/api/v1/clock/freeze
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "at": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/clock-service.md
}
