  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "country": "valor",
    "seed": 1
  }
}

docs {
  
  Ficha completa: docs/services/isin-service.md
}
