meta {
  name: POST /api/v1/allocations/propose
  type: http
  seq: 2
}

post {
  url: {{allocationEngineUrl}}/api/v1/allocations/propose
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "riskProfile": 1,
    "horizonYears": 1,
    "esg": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/allocation-engine.md
}
