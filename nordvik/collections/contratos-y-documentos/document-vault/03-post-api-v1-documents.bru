meta {
  name: POST /api/v1/documents
  type: http
  seq: 3
}

post {
  url: {{documentVaultUrl}}/api/v1/documents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "kind": "valor",
    "mimeType": "valor",
    "fileName": "valor",
    "contentBase64": "valor",
    "content": "valor",
    "contractId": "valor",
    "customerId": "valor",
    "expiresInSeconds": 1,
    "purpose": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/document-vault.md
}
