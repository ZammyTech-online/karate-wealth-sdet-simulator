meta {
  name: POST /api/v1/account-verifications
  type: http
  seq: 2
}

post {
  url: {{nordpayAdapterUrl}}/api/v1/account-verifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "iban": "valor",
    "nationalId": "valor",
    "name": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/nordpay-adapter.md
}
