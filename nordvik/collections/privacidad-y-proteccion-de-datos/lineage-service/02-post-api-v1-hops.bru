meta {
  name: POST /api/v1/hops
  type: http
  seq: 2
}

post {
  url: {{lineageServiceUrl}}/api/v1/hops
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "token": "valor",
    "service": "valor",
    "action": "valor",
    "purpose": "valor",
    "actor": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/lineage-service.md
}
