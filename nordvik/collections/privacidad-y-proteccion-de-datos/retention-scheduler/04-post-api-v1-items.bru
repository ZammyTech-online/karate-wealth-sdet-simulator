}

body:json {
  {
    "dataClass": "valor",
    "ownerService": "valor",
    "ref": "valor",
    "subject": "valor",
    "createdAt": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/retention-scheduler.md
}
