meta {
  name: POST /api/v1/keys/{id}/encrypt
  type: http
  seq: 10
}

post {
  url: {{keyManagementUrl}}/api/v1/keys/{id}/encrypt
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "plaintext": "valor",
    "ciphertext": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/key-management.md
}
