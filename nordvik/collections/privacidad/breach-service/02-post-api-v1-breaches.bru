meta {
  name: POST /api/v1/breaches
  type: http
  seq: 2
}

post {
  url: {{breachServiceUrl}}/api/v1/breaches
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "detectedAt": "valor",
    "description": "valor",
    "dataCategories": "valor",
    "affectedCustomerIds": "valor",
    "riskToRights": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/breach-service.md
}
