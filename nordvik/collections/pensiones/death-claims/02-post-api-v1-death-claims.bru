meta {
  name: POST /api/v1/death-claims
  type: http
  seq: 2
}

post {
  url: {{deathClaimsUrl}}/api/v1/death-claims
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Correlation-Id: bruno-{{$timestamp}}
}

body:json {
  {
    "customerId": "valor",
    "dateOfDeath": "valor",
    "reportedBy": "valor"
  }
}

docs {
  
  Ficha completa: docs/services/death-claims.md
}
